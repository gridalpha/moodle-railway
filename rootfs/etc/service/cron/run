#!/bin/sh
# Moodle cron, paced.
#
# cron.php keeps itself alive for ~180 seconds, polling for adhoc tasks about
# once a second and printing a line each time. Upstream sends that to /dev/null
# and so does this; stderr is left alone so a real failure still reaches
# `railway logs`. The trailing sleep is the gap between keep-alive windows —
# runit restarts this script as soon as it exits.

if [ "${RUN_CRON_TASKS:-true}" = "false" ]; then
    echo "RUN_CRON_TASKS=false - Moodle cron is disabled." >&2
    exec sleep 86400
fi

cd /var/www/html
/usr/bin/php /var/www/html/admin/cli/cron.php > /dev/null || \
    echo "moodle cron exited non-zero" >&2
exec sleep "${MOODLE_CRON_INTERVAL:-60}"
